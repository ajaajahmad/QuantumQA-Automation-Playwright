{
  "name": "messaging-platform-playwright-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright TypeScript end-to-end tests for a web messaging platform.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "HEADED=1 playwright test",
    "test:ui": "playwright test --ui",
    "auth:setup": "playwright test --project=auth-setup",
    "test:sms-campaign": "playwright test e2e/specs/campaign/create-sms-campaign.spec.ts",
    "test:app-push-send": "APP_PUSH_SEND=1 playwright test e2e/specs/app-push/send-push-campaign.spec.ts",
    "test:password-reset": "RESET_PASSWORD=1 playwright test --project=password-reset",
    "test:admin": "playwright test --project=admin-login --project=admin",
    "test:admin-write": "HEADED=1 ADMIN_WRITE=1 playwright test --project=admin-write",
    "codegen": "playwright codegen",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.12.12",
    "typescript": "^5.4.5"
  }
}
